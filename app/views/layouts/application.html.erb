<!DOCTYPE html>
<%# La fase decide todo el estilo (identidad.css): "fuera" en el lobby y las pantallas de antes y después; "carrera" en la carrera. %>
<html lang="es" data-fase="<%= content_for?(:fase) ? yield(:fase) : "fuera" %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : "Club Race" %></title>
  <link rel="icon" href="data:,">
  <%# La transición entre páginas va en línea: así la página la pide desde el primer cuadro, antes de que carguen las hojas. %>
  <style>@view-transition { navigation: auto; }</style>
  <%= csrf_meta_tags %>
  <%# Si dejás un archivo public/sonidos/the-world.* (mp3, ogg, wav o m4a), suena ese al largar en vez del sintetizado. %>
  <% the_world = Dir[Rails.public_path.join("sonidos", "the-world.{mp3,ogg,wav,m4a}").to_s].first %>
  <% if the_world %><meta name="sonido-the-world" content="/sonidos/<%= File.basename(the_world) %>"><% end %>
  <script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous" defer></script>
  <%= javascript_importmap_tags %>
  <link rel="stylesheet" href="/css/identidad.css?v=5">
  <link rel="stylesheet" href="/css/club.css?v=13">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/buttons.css">
  <%= yield :head %>
</head>
<body data-controller="button-fx" data-action="click->button-fx#play:capture">
<%= render "shared/dibujo_defs" %>
<% if content_for?(:pantalla_completa) %>
  <%# La sala con la carrera 3D: toda la pantalla es de la escena, sin menú. %>
  <%= yield %>
<% elsif logged_in? %>
  <div class="app">
    <div class="app-page">
      <%= render "layouts/topbar" %>
      <main class="app-main"><%= yield %></main>
    </div>
  </div>
<% else %>
  <div class="app-solo">
    <%= yield %>
  </div>
<% end %>
</body>
</html>
