<% content_for :title, "Club Race — Bots" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/css/races-list.css?v=19">
<% end %>

<%# Los bots del club: quién va primero y quiénes se fundieron. Un quebrado vuelve cuando junta su mínimo en donaciones. %>
<section class="ranking-pagina">
  <h1>Los bots del club</h1>
  <p class="subtitle">Juegan solos, cada uno en su horario. Nunca se recargan: el que se funde espera que alguien le done.</p>

  <h2>Apuestas</h2>
  <p class="ranking-nota">
    Apuesta por el bot que terminará con más plata. Mínimo <%= Apuesta::MINIMO %> USD, se descuenta al apostar y cada apuesta paga <%= Apuesta::IMPUESTO %> % de impuesto.
    Si aciertas cobras el doble, menos el 10 %; lo que se pierde va al pozo del torneo.
  </p>
  <ul class="ranking-lista">
    <li class="apuesta-mercado">
      <b>Día</b>
      <span class="ranking-nombre">Quién termina el día con más plata</span>
      <span class="ranking-saldo" title="Apostado hoy"><%= usd(@mercados["dia"][:apostado]) %> apostados</span>
      <small class="apuesta-nota"><%= @mercados["dia"][:abierto] ? "Abierto hasta las #{Apuesta::HORA_CIERRE_DIA}:00 (Chile)" : "Cerrado por hoy" %></small>
    </li>
    <li class="apuesta-mercado">
      <b>Temporada</b>
      <span class="ranking-nombre">Quién va primero al cerrar la temporada <%= @temporada.numero %></span>
      <span class="ranking-saldo" title="Apostado en la temporada"><%= usd(@mercados["temporada"][:apostado]) %> apostados</span>
      <small class="apuesta-nota"><%= @mercados["temporada"][:abierto] ? "Abierto hasta el final del día #{Apuesta::DIAS_TEMPORADA} de la temporada" : "Cerrado: ya pasó el día #{Apuesta::DIAS_TEMPORADA}" %></small>
    </li>
    <li class="apuesta-mercado">
      <b>Torneo</b>
      <span class="ranking-nombre">Pozo del torneo de la temporada <%= @temporada.numero %></span>
      <span class="ranking-saldo"><%= usd(@pozo_torneo) %></span>
    </li>
  </ul>

  <h2>Quién va primero</h2>
  <ol class="ranking-lista ranking-completo">
    <% @leaderboard.each.with_index(1) do |bot, puesto| %>
      <li>
        <b><%= puesto %>.º</b>
        <span class="ranking-nombre" title="<%= Bot.de(bot)&.personaje %>"><%= bot.username %></span>
        <span class="ranking-saldo"><%= usd(bot.balance) %></span>
        <%= render "apostar", bot: bot, mercados: %w[dia temporada] %>
      </li>
    <% end %>
  </ol>

  <h2>Quebrados</h2>
  <% if @quebrados.empty? %>
    <p class="empty-state">Ningún bot está quebrado.</p>
  <% else %>
    <ol class="ranking-lista ranking-completo">
      <% @quebrados.each do |bot| %>
        <li class="bot-quebrado">
          <span class="ranking-nombre" title="<%= bot.username %>"><%= bot.username %></span>
          <span class="ranking-saldo"><%= usd(bot.balance) %> de <%= usd(Bot::VUELVE_CON) %></span>
          <%= form_with url: donar_bot_path(bot), method: :post, style: "display:inline" do |f| %>
            <%= f.number_field :monto, min: 1, max: current_user.balance, value: 20, style: "width:5em" %>
            <%= f.submit "Donar", class: "btn-suave" %>
          <% end %>
          <%= render "apostar", bot: bot, mercados: %w[temporada] %>
        </li>
      <% end %>
    </ol>
  <% end %>

  <h2>Tus apuestas</h2>
  <% if @mis_apuestas.empty? %>
    <p class="empty-state">Todavía no apuestas.</p>
  <% else %>
    <ul class="ranking-lista">
      <% @mis_apuestas.each do |apuesta| %>
        <li class="apuesta-fila apuesta-<%= apuesta.estado %>">
          <b><%= apuesta.mercado == "dia" ? "Día" : "Temp." %></b>
          <span class="ranking-nombre"><%= apuesta.bot.username %> · <%= usd(apuesta.monto) %></span>
          <span class="apuesta-nota">
            <% if apuesta.abierta? %>
              Abierta · cierra <%= Apuesta.vence(apuesta.mercado, apuesta.temporada, apuesta.fecha).strftime("%d/%m %H:%M") %>
            <% elsif apuesta.estado == "ganada" %>
              Ganaste <%= usd(apuesta.pago) %>
            <% else %>
              Perdida · ganó <%= apuesta.ganador&.username %>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= link_to "← Volver a salas", root_path, class: "back-link" %>
</section>
