<% content_for :title, "Prototipo 3D" %>
<% content_for :page_title, "Prototipo 3D" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/css/races-new.css?v=3">
<% end %>

<div class="new-race-wrap">
  <h1>Carrera 3D</h1>
  <p class="subtitle">Crea una carrera real en una sala privada y la muestra en 3D: las posiciones llegan del servidor.</p>

  <%= form_with url: prototipo3d_path, method: :post, class: "formulario" do |f| %>
    <div class="field">
      <%= f.label :caballos, "Caballos" %>
      <%= f.select :caballos, (2..12).map { |n| [ n, n ] }, { selected: 8 } %>
    </div>
    <div class="field">
      <%= f.label :distancia, "Distancia en metros (2000 m ≈ 20 s)" %>
      <%= f.number_field :distancia, value: 2000, min: Race::DISTANCE_RANGE.min, max: Race::DISTANCE_RANGE.max, step: 100 %>
    </div>
    <%= f.submit "▶ Correr", class: "btn-submit", data: { fx: "start" } %>
    <div class="back-link">
      <%= link_to "Ver la versión simulada, sin servidor", "/prototipos/recta-final.html", data: { fx: "nav" } %>
    </div>
  <% end %>
</div>
