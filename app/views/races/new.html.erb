<% content_for :title, "Club Race — Nueva sala" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/css/races-new.css?v=4">
  <link rel="stylesheet" href="/css/slot-machine.css?v=3">
<% end %>

<%# La misma forma que el panel del inicio, como página: para el teléfono y para mostrar errores. %>
<div class="new-race-wrap">
  <%= render "races/formulario", race: @race, room_name: @room_name, en_dialogo: false %>
  <div class="back-link"><%= link_to "← Volver a salas", root_path, data: { fx: "back" } %></div>
</div>
