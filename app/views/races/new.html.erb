<% content_for :title, "Club Race — Nueva sala" %>
<% content_for :page_title, "Nueva sala" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/css/races-new.css?v=3">
  <link rel="stylesheet" href="/css/slot-machine.css?v=3">
<% end %>

<div class="new-race-wrap">
<h1>Nueva sala</h1>
<p class="subtitle">Configurá tu carrera multijugador</p>

<%= form_with model: @race, url: races_path, method: :post, class: "formulario",
              data: { controller: "slot-machine", slot_machine_format_value: "slug",
                      action: "submit->slot-machine#spin pageshow@window->slot-machine#restore" } do |f| %>

  <% if @race.errors.any? %>
    <ul class="error-list">
      <% @race.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="field">
    <span class="field-label">Nombre de sala</span>
    <%= render "shared/slot_machine", reels: Race::ROOM_NAME_REELS, results: @room_name[:words] %>
    <%= f.hidden_field :slug, value: @room_name[:slug], data: { slot_machine_target: "field" } %>
  </div>

  <div class="field">
    <%= f.label :capacity, "Capacidad" %>
    <%= f.select :capacity, (2..12).map { |n| [n, n] }, {}, {} %>
  </div>

  <div class="field">
    <%= f.label :distance, "Distancia en metros (2000 m ≈ 20 s)" %>
    <%= f.number_field :distance, min: Race::DISTANCE_RANGE.min, max: Race::DISTANCE_RANGE.max, step: 100 %>
  </div>

  <div class="field">
    <%= f.label :bet, "Apuesta base en USD (cada uno paga esto al entrar; el ganador se lleva el pozo)" %>
    <%= f.number_field :bet, min: Race::BET_RANGE.min, max: Race::BET_RANGE.max, step: 1 %>
  </div>

  <div class="field">
    <%= f.label :animal_type, "Tipo de animal" %>
    <%= f.select :animal_type, [["🐴 Caballos", "horse"], ["🐹 Cobayas", "guinea_pig"]] %>
  </div>

  <div class="toggle-row">
    <span class="toggle-label">Sala pública</span>
    <label class="toggle">
      <%= f.check_box :is_public, { checked: @race.is_public != false }, "1", "0" %>
      <span class="toggle-slider"></span>
    </label>
  </div>

  <%= f.submit "Crear sala", class: "btn-submit", data: { slot_machine_target: "button", fx: "create" } %>

  <div class="back-link">
    <%= link_to "← Volver a salas", root_path, data: { fx: "back" } %>
  </div>

<% end %>
</div>
