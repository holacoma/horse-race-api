<% content_for :title, "#{@race.slug} — Resultados" %>
<% content_for :page_title, @race.slug.upcase %>
<% content_for :head do %>
  <link rel="stylesheet" href="/css/race-results.css">
<% end %>

<%
  hues   = [ 0, 55, 110, 170, 220, 285 ]
  medals = { 1 => "🥇", 2 => "🥈", 3 => "🥉" }
  sprite = "/images/#{@race.animal_type}/frame_1.png"
  flip   = @race.animal_type == "horse" ? "transform:scaleX(-1);" : ""
  winner = @results.first
  my_position = @my_participant && @results.index(@my_participant) + 1
%>

<div class="results-wrap">
  <header class="results-hero">
    <img src="<%= sprite %>" alt=""
         style="<%= flip %>filter:hue-rotate(<%= hues[@lane_index[winner] % hues.size] %>deg)">
    <div>
      <% if my_position == 1 %>
        <h1>🏆 ¡Ganaste!</h1>
      <% else %>
        <h1>🏆 Ganó <%= winner.display_name %></h1>
      <% end %>
      <p class="results-winner-horse">con <%= winner.horse_name %></p>
      <% if my_position && my_position > 1 %>
        <p class="results-my-position">Llegaste en el puesto <%= my_position %></p>
      <% end %>
    </div>
  </header>

  <%# Arriba de la lista: con 12 jugadores, abajo quedarían fuera de la pantalla. %>
  <div class="results-actions">
    <%= link_to "← Volver a salas", races_path, class: "results-back", data: { fx: "back" } %>
    <%= link_to "＋ Nueva sala", new_race_path, class: "results-new", data: { fx: "create" } %>
  </div>

  <ol class="results-list">
    <% @results.each.with_index(1) do |participant, position| %>
      <li class="results-row<%= " is-me" if participant == @my_participant %>">
        <span class="results-position"><%= medals[position] || position %></span>
        <img src="<%= sprite %>" alt=""
             style="<%= flip %>filter:hue-rotate(<%= hues[@lane_index[participant] % hues.size] %>deg)">
        <span class="results-horse"><%= participant.horse_name %></span>
        <span class="results-player"><%= participant.display_name %></span>
      </li>
    <% end %>
  </ol>
</div>
