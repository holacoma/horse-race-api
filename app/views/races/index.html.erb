<% content_for :title, "Club Race" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/css/races-list.css?v=8">
<% end %>

<%# Dos cosas para hacer, nada más: jugar ya, o elegir una sala de las abiertas (o armar una para tus amigos). %>
<section class="inicio">
  <div class="inicio-hero">
    <div class="inicio-cartel">
      <%= render "shared/ventana_pradera" %>
      <h1 class="inicio-marca brilla-texto" data-texto="Club Race">Club Race</h1>
    </div>
    <p class="inicio-regla">La primera regla del Club Race es: no se habla del Club Race.</p>
    <%= button_to "Jugar ya", jugar_path, class: "btn-jugar brilla", form_class: "inicio-jugar", data: { fx: "start" } %>
    <p class="inicio-ayuda">Te suma a una sala abierta con tu caballo. Si no hay ninguna, abre una.</p>
    <%= link_to "Armar una sala para tus amigos", new_race_path, class: "inicio-crear", data: { fx: "create" } %>
  </div>

  <div class="inicio-salas">
    <h2>Salas abiertas</h2>
    <% if @races.empty? %>
      <p class="empty-state">No hay salas abiertas. Con "Jugar ya" abrís la primera.</p>
    <% else %>
      <div class="rooms-grid">
        <% @races.each do |race| %>
          <% participants = race.participants.sort_by(&:created_at) %>
          <%= link_to race_path(race), class: "room-card", data: { fx: "join" } do %>
            <span class="room-slug"><%= race.slug %></span>
            <span class="room-meta">de <%= race.creator&.username || "anónimo" %> · <%= race.distance %> m</span>
            <span class="room-lugares" aria-label="<%= participants.size %> de <%= race.capacity %> lugares">
              <% race.capacity.times do |i| %>
                <i class="<%= 'ocupado' if i < participants.size %>" style="--c: <%= color_de_carril(i, tinta: true) %>"></i>
              <% end %>
            </span>
            <span class="room-unirse">Unirse</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<div class="galope" aria-hidden="true">
  <i style="--dur: 8s; --retraso: .5s"><b>🐎</b></i>
  <i style="--dur: 11s; --retraso: 4s"><b>🏇</b></i>
</div>
