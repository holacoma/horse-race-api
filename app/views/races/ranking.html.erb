<% content_for :title, "Club Race — Ranking" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/css/races-list.css?v=12">
<% end %>

<%# El ranking completo: los que más plata tienen. Solo cuentas de Google. %>
<section class="ranking-pagina">
  <h1>Los más ricos</h1>
  <p class="subtitle">Todos empiezan con <%= usd(User.new.balance) %>. Cada carrera cuesta la apuesta de la sala y el ganador cobra el doble de todo lo apostado.</p>
  <% if @ranking.empty? %>
    <p class="empty-state">Todavía nadie entró con Google.</p>
  <% else %>
    <ol class="ranking-lista ranking-completo">
      <% @ranking.each.with_index(1) do |user, puesto| %>
        <li class="<%= 'tu' if user == current_user %>">
          <b><%= puesto %>.º</b>
          <%= link_to user.username, profile_path(user.username), class: "ranking-nombre" %>
          <span class="ranking-saldo"><%= usd(user.balance) %></span>
        </li>
      <% end %>
    </ol>
  <% end %>
  <% if current_user.guest? %><p class="ranking-nota">Jugás como invitado: tenés <%= usd(current_user.balance) %>, pero solo las cuentas de Google figuran en el ranking.</p><% end %>
  <%= link_to "← Volver a salas", root_path, class: "back-link" %>
</section>
